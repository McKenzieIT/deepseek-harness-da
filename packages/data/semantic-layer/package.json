{
  "name": "@deepseek-ai/dsh-semantic-layer",
  "description": "Cordis adapter for @semantic-grounding/substrate: provides the substrate's SemanticGroundingCore as ctx.schema, bridges the fiber lifetime to core.dispose(), reactively wires the optional audit + scopes collaborators, and ships the enrichment-llm-wiring plugin that feeds ctx.llm into the enrichment seam.",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/data/semantic-layer"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@semantic-grounding/substrate": "^0.1.6-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@deepseek-ai/dsh-audit": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@deepseek-ai/dsh-audit": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^"
  }
}
