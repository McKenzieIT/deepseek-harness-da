{
  "name": "@deepseek-ai/dsh-data-agent",
  "description": "[data-agent] The data-agent bundle: an additive patch layer over dsh-base that reserves mounts for data capability plugins (P4-P11) and disables the code-agent surface",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/data-agent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-presets": "workspace:^",
    "@deepseek-ai/dsh-audit": "workspace:^",
    "@deepseek-ai/dsh-client-ui-semantic-layer": "workspace:^",
    "@deepseek-ai/dsh-code-runtime-data-python": "workspace:^",
    "@deepseek-ai/dsh-evidence-query": "workspace:^",
    "@deepseek-ai/dsh-eval-runner-service": "workspace:^",
    "@deepseek-ai/dsh-goal-eval-context": "workspace:^",
    "@deepseek-ai/dsh-goal-eval-policy": "workspace:^",
    "@deepseek-ai/dsh-admin": "workspace:^",
    "@deepseek-ai/dsh-identity": "workspace:^",
    "@deepseek-ai/dsh-nl2sql-engine": "workspace:^",
    "@deepseek-ai/dsh-phase-gate": "workspace:^",
    "@deepseek-ai/dsh-preset-autojoin": "workspace:^",
    "@deepseek-ai/dsh-query-maxcompute": "workspace:^",
    "@deepseek-ai/dsh-result-cache-memory": "workspace:^",
    "@deepseek-ai/dsh-query-tool": "workspace:^",
    "@deepseek-ai/dsh-schema-gateway": "workspace:^",
    "@deepseek-ai/dsh-scope-registry": "workspace:^",
    "@deepseek-ai/dsh-semantic-layer": "workspace:^",
    "@deepseek-ai/dsh-tool-critique-sql": "workspace:^",
    "@deepseek-ai/dsh-tool-evaluate-sql-quality": "workspace:^",
    "@deepseek-ai/dsh-tool-load-event-definition": "workspace:^",
    "@deepseek-ai/dsh-tool-load-table-definition": "workspace:^",
    "@deepseek-ai/dsh-tool-present-clarification": "workspace:^",
    "@deepseek-ai/dsh-tool-compute": "workspace:^",
    "@deepseek-ai/dsh-tool-present-decomposition": "workspace:^",
    "@deepseek-ai/dsh-tool-present-table": "workspace:^",
    "@deepseek-ai/dsh-tool-suggest-followups": "workspace:^",
    "@deepseek-ai/dsh-tool-search-data-sources": "workspace:^",
    "@deepseek-ai/dsh-tool-update-table-config": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}